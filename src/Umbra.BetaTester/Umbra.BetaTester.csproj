<Project Sdk="Microsoft.NET.Sdk">

  <!-- AI beta tester: plays the domain simulation headless with player profiles and writes a report. Never changes rules. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbra.BetaTester</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbra.Domain\Umbra.Domain.csproj" />
  </ItemGroup>

</Project>
