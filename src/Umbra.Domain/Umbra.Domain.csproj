<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gameplay domain: pure C#, no Godot dependency. Rules, data and simulation live here; the Godot project only draws. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbra.Domain</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
